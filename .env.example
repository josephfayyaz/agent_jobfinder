APP_ENV=development
DATABASE_URL=postgresql+psycopg://job_agent:job_agent@db:5432/job_agent
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_SMALL_MODEL=
LM_STUDIO_WRITER_MODEL=
LM_STUDIO_REQUEST_TIMEOUT_SECONDS=90
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.4
OPENAI_ESCALATION_MODEL=gpt-5.3-codex
