# =============================================================================
# Local LLM Job Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All settings have working defaults; only override what you need.
# Never commit .env — it is gitignored.
# =============================================================================

# ── General ───────────────────────────────────────────────────────────────────
APP_ENV=development                        # development | production
DEFAULT_CANDIDATE_ID=

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use the default SQLite file at <project_root>/job_agent.db.
# Override only if you want a custom absolute SQLite path.
DATABASE_URL=

# ── LM Studio (local inference) ───────────────────────────────────────────────
# Any OpenAI-compatible server works (LM Studio, Ollama, llama.cpp, etc.)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Model roles — set to the exact model ID shown in your inference server.
# Leaving a role empty ("") disables it and falls back to heuristics.
LM_STUDIO_SMALL_MODEL=qwen3.5-9b-mlx                          # reviewer, router, matching
LM_STUDIO_WRITER_MODEL=qwen3.5-27b-claude-4.6-opus-distilled-mlx  # CV drafting, emails
LM_STUDIO_MID_MODEL=openai/gpt-oss-20b                        # expert enhancement, extraction
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5     # semantic matching (optional)
SEMANTIC_MATCHING_WEIGHT=0.4
MATCH_MIN_SCORE=75
TARGET_JOB_SENIORITY=junior

# Token budgets per model role.
# These models use a reasoning/thinking phase — budget must cover BOTH
# reasoning tokens AND the actual JSON output. Increase if output is cut off.
LM_STUDIO_MAX_TOKENS_SMALL=4000
LM_STUDIO_MAX_TOKENS_WRITER=6000
LM_STUDIO_MAX_TOKENS_MID=4000

LM_STUDIO_REQUEST_TIMEOUT_SECONDS=120     # seconds; increase for slow hardware

# ── OpenAI (optional cloud escalation) ────────────────────────────────────────
# Leave OPENAI_API_KEY empty to keep everything local.
OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-4o
OPENAI_ESCALATION_MODEL=gpt-4o
USE_OPENAI_REVIEW=false                   # true = use OpenAI for CV review
USE_OPENAI_ESCALATION=false               # true = escalate failed drafts to OpenAI

# ── Anthropic / Claude (optional final polish) ─────────────────────────────────
# Leave ANTHROPIC_API_KEY empty to keep everything local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6         # or claude-opus-4-6 for highest quality
USE_CLAUDE_FINAL_REVIEW=false             # true = use Claude for final resume polish
CLEARBIT_API_KEY=

# ── CV Workflow thresholds ─────────────────────────────────────────────────────
CV_PASS_SCORE=85     # score >= this → draft accepted as-is
CV_REVISE_SCORE=60   # score >= this → targeted revision; below → full rewrite
BULLET_CLARIFY_WORD_LIMIT=22

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_POLL_SECONDS=5     # how often the background worker checks for tasks
SCAN_MAX_WORKERS=5
SCANNER_MAX_WORKERS=4
VELOCITY_SPIKE_THRESHOLD=3
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_LABEL_FILTER=LinkedIn Jobs
GMAIL_MAX_EMAILS_PER_SYNC=50
GMAIL_AUTO_SYNC=false
GMAIL_SYNC_INTERVAL_MINUTES=30
LINKEDIN_FETCH_DELAY_SECONDS=2.0
USE_JOBSPY=false
JOBSPY_REQUEST_DELAY=2.0
JOBSPY_DEFAULT_LIMIT=50
# JOBSPY_DISCOVER_INTERVAL_HOURS=6
# JOBSPY_DISCOVER_QUERIES=["Target Role 1","Target Role 2"]
# JOBSPY_DISCOVER_LOCATION=Italy

# ── Artifacts ────────────────────────────────────────────────────────────────
ARTIFACTS_DIR=generated   # output folder for .tex, .pdf, and CSV exports
