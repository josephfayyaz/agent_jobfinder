{
  "name": "job-agent-frontend",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./frontend/static/tailwind.input.css -o ./frontend/static/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./frontend/static/tailwind.input.css -o ./frontend/static/tailwind.css --watch",
    "dev:vue": "vite --config vite.config.js",
    "build:vue": "vite build --config vite.config.js",
    "preview:vue": "vite preview --config vite.config.js"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.11"
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  }
}
